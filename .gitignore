settings.json
holidays.json
agenda_cache.json
agenda_edit.json

# ---- 字体构建源（tools/build_fonts.py 可重新下载）----
tools/_font_src/

# ---- 本地工作区数据 ----
.workbuddy/

# ---- 图片素材（v1.9.26 起集中到 assets/）----
